import java.util.*;

public class task10 {

    public static void matrixRotation(int[][] matrix, int r) {

        int m = matrix.length;
        int n = matrix[0].length;

        int layers = Math.min(m, n) / 2;

        for (int layer = 0; layer < layers; layer++) {

            int top = layer;
            int bottom = m - 1 - layer;
            int left = layer;
            int right = n - 1 - layer;

            // Store the current layer in a list
            ArrayList<Integer> values = new ArrayList<>();

            // Top row: left -> right
            for (int j = left; j <= right; j++) {
                values.add(matrix[top][j]);
            }

            // Right column: top+1 -> bottom
            for (int i = top + 1; i <= bottom; i++) {
                values.add(matrix[i][right]);
            }

            // Bottom row: right-1 -> left
            for (int j = right - 1; j >= left; j--) {
                values.add(matrix[bottom][j]);
            }

            // Left column: bottom-1 -> top+1
            for (int i = bottom - 1; i > top; i--) {
                values.add(matrix[i][left]);
            }

            // Number of positions in this layer
            int size = values.size();

            // Effective rotation
            int shift = r % size;

            int index = 0;

            // Put rotated values back

            // Top row
            for (int j = left; j <= right; j++) {
                matrix[top][j] = values.get((index + shift) % size);
                index++;
            }

            // Right column
            for (int i = top + 1; i <= bottom; i++) {
                matrix[i][right] = values.get((index + shift) % size);
                index++;
            }

            // Bottom row
            for (int j = right - 1; j >= left; j--) {
                matrix[bottom][j] = values.get((index + shift) % size);
                index++;
            }

            // Left column
            for (int i = bottom - 1; i > top; i--) {
                matrix[i][left] = values.get((index + shift) % size);
                index++;
            }
        }

        // Print matrix
        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                System.out.print(matrix[i][j]);

                if (j < n - 1) {
                    System.out.print(" ");
                }
            }
            System.out.println();
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int m = sc.nextInt();
        int n = sc.nextInt();
        int r = sc.nextInt();

        int[][] matrix = new int[m][n];

        for (int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                matrix[i][j] = sc.nextInt();
            }
        }

        matrixRotation(matrix, r);

        sc.close();
    }
}
